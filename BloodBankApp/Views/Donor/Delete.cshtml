@model BloodBankApp.EF.Tables.Donor
@{
    ViewData["Title"] = "Delete Donor";
}
<h1>Are you sure you want to delete this donor?</h1>
<h2>Full Name: @Model.FullName</h2>
<h2>Blood Group: @Model.BloodGroup</h2>
<h2>Contact No: @Model.ContactNo</h2>
<h2>City: @Model.City</h2>

<form action="" method="post">
    <input type="hidden" name="DonorId" value="@Model.DonorId" />
    <input type="submit" name="Dcsn" value="Yes" class="btn btn-danger" />
    <input type="submit" name="Dcsn" value="No" class="btn btn-success" />
</form>
