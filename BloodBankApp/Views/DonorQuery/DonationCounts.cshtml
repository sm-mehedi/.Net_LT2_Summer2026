@model List<BloodBankApp.Models.DonorDonationCount>
@{
    ViewData["Title"] = "Donation Counts per Donor";
}
<h1>Total Number of Donations per Donor</h1>
<a href="/donor/index" class="btn btn-secondary mb-2">Back to Donors</a>

@if (Model.Count != 0)
{
    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Full Name</th>
            <th>Blood Group</th>
            <th>Total Donations</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DonorId</td>
                <td>@item.FullName</td>
                <td>@item.BloodGroup</td>
                <td>@item.DonationCount</td>
            </tr>
        }
    </table>
}
else
{
    <p>No data Found</p>
}
