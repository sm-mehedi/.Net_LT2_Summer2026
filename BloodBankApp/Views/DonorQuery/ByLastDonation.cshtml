@model List<BloodBankApp.EF.Tables.Donor>
@{
    ViewData["Title"] = "Donors by Last Donation Date";
}
<h1>Donors Sorted by Last Donation Date (Most Recent First)</h1>
<a href="/donor/index" class="btn btn-secondary mb-2">Back to Donors</a>

@if (Model.Count != 0)
{
        <table class="table table-bordered">
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Blood Group</th>
                <th>City</th>
                <th>Last Donation Date</th>
            </tr>
        @foreach (var item in Model)
        {
                    <tr>
                        <td>@item.DonorId</td>
                        <td>@item.FullName</td>
                        <td>@item.BloodGroup</td>
                        <td>@item.City</td>
                        <td>@(item.LastDonationDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                    </tr>
        }
        </table>
}
else
{
        <p>No data Found</p>
}
